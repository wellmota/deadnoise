{
  "manifest_version": 3,
  "name": "DeadNoise: volume por aba",
  "description": "Mostra as abas que tocam som no DeadNoise (app do Mac) e deixa ajustar o volume e o mudo de cada uma.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "nativeMessaging", "scripting", "storage", "alarms", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
